# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: sync slash commands to one guild instantly while developing
DISCORD_GUILD_ID=

# EA FC year used by FUT.GG (27 = EA FC 27)
FUT_GAME_YEAR=27

# How often the background scanner polls prices, in seconds
POLL_INTERVAL_SECONDS=120

# Default %-change that counts as a "strong" move for watched players
DEFAULT_THRESHOLD_PCT=10

# Ignore cheap fodder during the automatic market scan
SCAN_MIN_PRICE=10000

# Minutes to wait before alerting the same player again
ALERT_COOLDOWN_MINUTES=30

# SQLite database path
DATABASE_PATH=data/futbot.db
