# Discord application (Developer Portal → Bot / OAuth2)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register slash commands instantly on a test guild.
# If omitted, commands are registered globally (can take up to ~1 hour).
DISCORD_GUILD_ID=

# Market defaults
# ps | xbox | pc  — v1 default is PlayStation console prices
DEFAULT_PLATFORM=ps

# In-memory price cache TTL (milliseconds). Default: 1 hour.
PRICE_CACHE_TTL_MS=3600000

# How often the alert scheduler compares alerts against the cache.
# Default: 15 minutes. Does not fetch live FUTBIN more often than the cache TTL.
ALERT_CHECK_INTERVAL_MS=900000
